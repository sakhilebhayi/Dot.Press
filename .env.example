APP_NAME=Dot.Press
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pres.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is the database, locally and in production (a single file on the
# shared host). The connection's busy_timeout / WAL / synchronous settings live
# in config/database.php; override with DB_BUSY_TIMEOUT, DB_JOURNAL_MODE,
# DB_SYNCHRONOUS, DB_TRANSACTION_MODE if ever needed.
DB_CONNECTION=sqlite
# Leave DB_DATABASE unset to use database/database.sqlite, or give an absolute
# path. Do not set it to a bare name: SQLite would create a file of that name
# in the working directory.
# DB_DATABASE=/home/ACCOUNT/APP/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# No websocket server exists on the production host, so broadcasting is off:
# "null" drops every broadcast (the slide-update event is not even queued) and
# the browser never opens a websocket because VITE_REVERB_APP_KEY is empty.
# Presence/cursors work without it (cache heartbeat). To try live canvas
# co-editing locally, set BROADCAST_CONNECTION=reverb, fill the REVERB_* values
# below and run `php artisan reverb:start` and `npm run dev`; never on the host.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
ASSET_UPLOAD_DISK=local
ASSET_SIGNED_URL_TTL=10
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAX_TOKENS=1200
ANTHROPIC_TIMEOUT_SECONDS=20
AI_DAILY_QUOTA=100
AI_RATE_LIMIT_PER_MINUTE=20
AI_LOG_MAX_PROMPT_CHARS=5000
AI_LOG_MAX_RESPONSE_CHARS=5000

VITE_APP_NAME="${APP_NAME}"
