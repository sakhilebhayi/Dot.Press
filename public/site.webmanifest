{
  "name": "Dot.Press",
  "short_name": "Dot.Press",
  "description": "Presentations built as a line of claims: each slide is a bead, hollow until it shows evidence.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef0f1",
  "theme_color": "#14171a",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
